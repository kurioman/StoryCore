{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lumencia/character.schema.json",
  "title": "Lumencia Character Record",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "confidence",
    "canon_status",
    "source_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "type": "string"
    },
    "department_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "social_status": {
      "type": "string"
    },
    "power": {
      "type": "object",
      "additionalProperties": true
    },
    "appearance": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "personality_traits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "motivation": {
      "type": "string"
    },
    "story_functions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "faction_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationship_notes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "canon_status": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
